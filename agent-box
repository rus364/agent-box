#!/usr/bin/env python3
"""agent-box launcher entrypoint.

Kept as a single small file so it works both as a host executable and as the
one file that gets bind-mounted into the container. The actual implementation
lives in the ``agent_box`` package, found either next to this file (normal
checkout/host use) or at a fixed container library path (when this file is
mounted standalone; see agent_box.runtime.build_mounts).
"""
from __future__ import annotations

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
for _candidate in (_HERE, _HERE.parent / "lib/agent-box", Path.home() / ".local/lib/agent-box"):
    if (_candidate / "agent_box" / "__init__.py").is_file():
        if str(_candidate) not in sys.path:
            sys.path.insert(0, str(_candidate))
        break

from agent_box.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
