def read_json(path: Path) -> Any:
    with path.open(encoding="utf-8") as f:
        return json.load(f)


def atomic_write_text(path: Path, text: str, mode: int | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".agent-box.", dir=path.parent)
    tmp = Path(name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def atomic_write_json(path: Path, value: Any, mode: int | None = None) -> None:
    atomic_write_text(path, json.dumps(value, ensure_ascii=False, separators=(",", ":")) + "\n", mode)


def http_json(url: str, *, headers: dict[str, str] | None = None, data: bytes | None = None, timeout: float = 15) -> Any:
    request = urllib.request.Request(url, data=data, headers=headers or {})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def telegram_send(text: str) -> bool:
    if not NOTIFY_CONFIG.is_file():
        return True
    try:
        cfg = read_json(NOTIFY_CONFIG)
        token, chat_id = str(cfg["token"]), str(cfg["chat_id"])
    except (OSError, ValueError, KeyError, TypeError):
        return True
    data = urllib.parse.urlencode({"chat_id": chat_id, "text": text}).encode()
    try:
        http_json(f"https://api.telegram.org/bot{token}/sendMessage", data=data, timeout=10)
        return True
    except (OSError, ValueError, urllib.error.URLError):
        return False


def notify_project(cwd: str) -> str:
    if not cwd or cwd == "/":
        return "unknown"
    return Path(cwd).name or "unknown"


def parse_payload(payload: str) -> dict[str, Any]:
    try:
        obj = json.loads(payload)
    except json.JSONDecodeError:
        return {}
    return obj if isinstance(obj, dict) else {}


def notify_claude() -> None:
    obj = parse_payload(sys.stdin.read())
    event = str(obj.get("hook_event_name") or "")
    kind = str(obj.get("notification_type") or "")
    project = notify_project(str(obj.get("cwd") or ""))
    message = str(obj.get("message") or obj.get("error") or "")
    if (event, kind) == ("Notification", "permission_prompt"):
        title, detail = f"Claude · {project} · needs permission", message or "Claude is waiting for approval."
    elif (event, kind) == ("Notification", "idle_prompt"):
        title, detail = f"Claude · {project} · waiting for input", message or "Claude is waiting for your input."
    elif event == "Stop":
        title, detail = f"Claude · {project} · finished", "Turn completed."
    elif event == "StopFailure":
        title, detail = f"Claude · {project} · stopped", message or "Claude stopped because of an API error."
    else:
        return
    telegram_send(f"{title}\n{detail}")


def notify_codex(payload: str | None) -> None:
    obj = parse_payload(payload if payload is not None else sys.stdin.read())
    if obj.get("type") != "agent-turn-complete":
        return
    project = notify_project(str(obj.get("cwd") or os.getcwd()))
    detail = str(obj.get("last-assistant-message") or "Turn completed.")
    telegram_send(f"Codex · {project} · finished\n{detail}")


def hook_entry(matcher: str | None = None) -> dict[str, Any]:
    item: dict[str, Any] = {"hooks": [{"type": "command", "command": NOTIFY_COMMAND}]}
    if matcher:
        item["matcher"] = matcher
    return item


def install_claude_notify_hooks() -> None:
    path = HOST_HOME / ".claude/settings.json"
    settings = read_json(path) if path.exists() else {}
    if not isinstance(settings, dict):
        raise AgentBoxError(f"{path} must contain a JSON object")
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise AgentBoxError(f"{path}: hooks must be a JSON object")
    for event, entry in (
        ("Notification", hook_entry("permission_prompt")),
        ("Notification", hook_entry("idle_prompt")),
        ("Stop", hook_entry()),
        ("StopFailure", hook_entry()),
    ):
        items = hooks.setdefault(event, [])
        if not isinstance(items, list):
            raise AgentBoxError(f"{path}: hooks.{event} must be a list")
        if entry not in items:
            items.append(entry)
    atomic_write_json(path, settings)


def uses_notify(entry: Any) -> bool:
    return isinstance(entry, dict) and isinstance(entry.get("hooks"), list) and any(
        isinstance(h, dict) and h.get("type") == "command" and h.get("command") == NOTIFY_COMMAND
        for h in entry["hooks"]
    )


def remove_claude_notify_hooks() -> None:
    path = HOST_HOME / ".claude/settings.json"
    if not path.exists():
        return
    settings = read_json(path)
    if not isinstance(settings, dict):
        raise AgentBoxError(f"{path} must contain a JSON object")
    hooks = settings.get("hooks")
    if isinstance(hooks, dict):
        cleaned = {}
        for event, items in hooks.items():
            if not isinstance(items, list):
                cleaned[event] = items
                continue
            remaining = [x for x in items if not uses_notify(x)]
            if remaining:
                cleaned[event] = remaining
        if cleaned:
            settings["hooks"] = cleaned
        else:
            settings.pop("hooks", None)
    atomic_write_json(path, settings)


def notify_setup() -> None:
    token = getpass.getpass("Telegram bot token: ")
    chat_id = input("Telegram chat ID: ")
    if not token or not chat_id:
        die("Telegram bot token and chat ID cannot be empty")
    atomic_write_json(NOTIFY_CONFIG, {"token": token, "chat_id": chat_id}, stat.S_IRUSR | stat.S_IWUSR)
    try:
        install_claude_notify_hooks()
        if not telegram_send("agent-box · Telegram notifications enabled"):
            raise AgentBoxError("Telegram test failed")
    except BaseException:
        NOTIFY_CONFIG.unlink(missing_ok=True)
        try:
            remove_claude_notify_hooks()
        except Exception:
            pass
        raise
    print("agent-box: Telegram notifications enabled for Claude and Codex")


def compact_time(seconds: float) -> str:
    s = max(0, int(seconds))
    if s >= 86400:
        return f"{s // 86400}d{(s % 86400) // 3600}h"
    if s >= 3600:
        return f"{s // 3600}h{(s % 3600) // 60}m"
    return f"{s // 60}m"


def format_codex_usage(data: Any) -> str:
    rate = data.get("rate_limit", {}) if isinstance(data, dict) else {}
    windows = [w for w in (rate.get("primary_window"), rate.get("secondary_window")) if isinstance(w, dict)]
    short = next((w for w in windows if w.get("limit_window_seconds") is not None and float(w["limit_window_seconds"]) <= 86400), None)
    week = next((w for w in windows if w.get("limit_window_seconds") is not None and float(w["limit_window_seconds"]) > 86400), None)
    if short is None and week is None:
        raise AgentBoxError("response carried no recognizable rate-limit windows")

    def remaining(w: Any) -> str:
        return "—" if not isinstance(w, dict) or w.get("used_percent") is None else str(int(100 - float(w["used_percent"])))

    def reset(w: Any) -> str:
        return "—" if not isinstance(w, dict) or w.get("reset_after_seconds") is None else compact_time(float(w["reset_after_seconds"]))

    return f"{remaining(short)}/{remaining(week)} · {reset(short)}/{reset(week)}"


def parse_epoch(value: Any) -> float | None:
    if isinstance(value, (int, float)):
        return float(value)
    if not isinstance(value, str):
        return None
    text = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        return datetime.fromisoformat(text).timestamp()
    except ValueError:
        return None


def normalize_claude_usage(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        return {"rate_limits": {}}
    if isinstance(data.get("rate_limits"), dict):
        return {"rate_limits": data["rate_limits"]}

    def window(w: Any) -> dict[str, Any] | None:
        if not isinstance(w, dict):
            return None
        return {"used_percentage": w.get("used_percentage", w.get("utilization")), "resets_at": parse_epoch(w.get("resets_at"))}

    return {"rate_limits": {"five_hour": window(data.get("five_hour")), "seven_day": window(data.get("seven_day"))}}


def format_claude_usage(data: Any, now: float | None = None) -> str:
    now = time.time() if now is None else now
    rate = normalize_claude_usage(data).get("rate_limits", {})

    def fmt(w: Any) -> tuple[str, str]:
        if not isinstance(w, dict):
            return "—", "—"
        used = w.get("used_percentage", w.get("utilization"))
        reset_at = parse_epoch(w.get("resets_at"))
        if used is None or reset_at is None or reset_at <= now:
            return "—", "—"
        return str(int(100 - float(used))), compact_time(reset_at - now)

    a, ar = fmt(rate.get("five_hour"))
    b, br = fmt(rate.get("seven_day"))
    return f"{a}/{b} · {ar}/{br}"


def cache_fresh(path: Path, ttl: int) -> bool:
    try:
        st = path.stat()
        return st.st_size > 0 and time.time() - st.st_mtime < ttl
    except OSError:
        return False


def codex_usage() -> str:
    root = Path(os.environ.get("XDG_CACHE_HOME", str(HOST_HOME / ".cache")))
    cache = root / "codex/usage.json"
    ttl = int(os.environ.get("CODEX_USAGE_CACHE_TTL", "60"))
    auth = Path(os.environ.get("CODEX_AUTH_PATH", str(Path(os.environ.get("CODEX_HOME", str(HOST_HOME / ".codex"))) / "auth.json")))
    url = os.environ.get("CODEX_USAGE_URL", "https://chatgpt.com/backend-api/wham/usage")
    if cache_fresh(cache, ttl):
        return format_codex_usage(read_json(cache))
    if not auth.is_file():
        print(f"agent-box usage codex: authentication file not found: {auth}", file=sys.stderr)
        raise AgentBoxError("Codex authentication unavailable")
    try:
        tokens = read_json(auth)["tokens"]
        token = tokens["access_token"]
        account_id = tokens.get("account_id")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise AgentBoxError(f"access token not found in {auth}") from exc
    headers = {"Authorization": f"Bearer {token}"}
    if account_id:
        headers["chatgpt-account-id"] = str(account_id)
    try:
        response = http_json(url, headers=headers)
        atomic_write_json(cache, response)
        return format_codex_usage(response)
    except Exception:
        if cache.is_file() and cache.stat().st_size:
            print("agent-box usage codex: request failed; showing cached usage", file=sys.stderr)
            return format_codex_usage(read_json(cache))
        raise AgentBoxError("Codex usage request failed")


def claude_usage(statusline: bool = False, payload: str | None = None) -> str:
    root = Path(os.environ.get("XDG_CACHE_HOME", str(HOST_HOME / ".cache")))
    cache = root / "claude-code/rate-limits.json"
    credentials = Path(os.environ.get("CLAUDE_CREDENTIALS_PATH", str(HOST_HOME / ".claude/.credentials.json")))
    url = os.environ.get("CLAUDE_CODE_CUSTOM_OAUTH_URL", "https://api.anthropic.com").rstrip("/") + "/api/oauth/usage"
    ttl = int(os.environ.get("CLAUDE_USAGE_CACHE_TTL", "60"))
    if statusline:
        obj = parse_payload(payload if payload is not None else sys.stdin.read())
        if isinstance(obj.get("rate_limits"), dict):
            atomic_write_json(cache, normalize_claude_usage(obj))
        return format_claude_usage(obj)
    if cache_fresh(cache, ttl):
        return format_claude_usage(read_json(cache))
    if credentials.is_file():
        try:
            token = read_json(credentials)["claudeAiOauth"]["accessToken"]
            response = http_json(url, headers={
                "Authorization": f"Bearer {token}",
                "anthropic-beta": "oauth-2025-04-20",
                "Content-Type": "application/json",
                "User-Agent": "claude-cli (external, cli)",
            })
            normalized = normalize_claude_usage(response)
            atomic_write_json(cache, normalized)
            return format_claude_usage(normalized)
        except Exception:
            pass
    else:
        print(f"agent-box usage claude: OAuth credentials not found: {credentials}", file=sys.stderr)
    if cache.is_file() and cache.stat().st_size:
        return format_claude_usage(read_json(cache))
    return PLACEHOLDER_USAGE


def usage_command(args: list[str]) -> None:
    if not args:
        die("usage provider required; expected codex, claude, or all")
    provider, rest = args[0], args[1:]
    if provider == "claude":
        if rest not in ([], ["--statusline"]):
            die("agent-box usage claude accepts only --statusline")
        print(claude_usage(bool(rest)))
    elif provider == "codex":
        if rest:
            die("agent-box usage codex takes no arguments")
        print(codex_usage())
    elif provider == "all":
        if rest != ["--statusline"]:
            die("agent-box usage all requires --statusline")
        payload = sys.stdin.read()
        try:
            claude = claude_usage(True, payload)
        except Exception:
            claude = PLACEHOLDER_USAGE
        try:
            codex = codex_usage()
        except Exception:
            codex = PLACEHOLDER_USAGE
        print(f"Claude {claude} │ Codex {codex}")
    else:
        die(f"unsupported usage provider '{provider}'; expected codex, claude, or all")


def notify_command(args: list[str]) -> None:
    if not args:
        die("notify action required; expected setup, test, status, or disable")
    action, rest = args[0], args[1:]
    if action == "setup":
        if rest: die("agent-box notify setup takes no arguments")
        notify_setup()
    elif action == "test":
        if rest: die("agent-box notify test takes no arguments")
        if not NOTIFY_CONFIG.is_file(): die("Telegram notifications are not configured")
        if not telegram_send("agent-box · test notification"): die("Telegram test failed")
        print("agent-box: test notification sent")
    elif action == "status":
        if rest: die("agent-box notify status takes no arguments")
        print("Telegram notifications: enabled" if NOTIFY_CONFIG.is_file() else "Telegram notifications: disabled")
        if NOTIFY_CONFIG.is_file(): print(f"Config: {NOTIFY_CONFIG}")
    elif action == "disable":
        if rest: die("agent-box notify disable takes no arguments")
        NOTIFY_CONFIG.unlink(missing_ok=True)
        remove_claude_notify_hooks()
        print("agent-box: Telegram notifications disabled")
    elif action == "claude":
        if rest: die("agent-box notify claude takes no arguments")
        notify_claude()
    elif action == "codex":
        if len(rest) > 1: die("agent-box notify codex accepts at most one payload argument")
        notify_codex(rest[0] if rest else None)
    else:
        die("notify action required; expected setup, test, status, or disable")


def ensure_state_dirs() -> None:
    for path in (
        BUILD_STATE, STATE_ROOT / "cache", STATE_ROOT / "uv", STATE_ROOT / "mise",
        STATE_ROOT / "git", STATE_ROOT / "gh", HOST_HOME / ".codex", HOST_HOME / ".claude",
        HOST_HOME / ".cache/claude-code", HOST_HOME / ".cache/claude-cli-nodejs",
    ):
        path.mkdir(parents=True, exist_ok=True)


def migrate_statusline() -> None:
    path = HOST_HOME / ".claude/settings.json"
    if not path.is_file():
        return
    try:
        settings = read_json(path)
        status = settings.get("statusLine")
        if isinstance(status, dict) and status.get("command") in {
            "~/.local/bin/claude-usage --statusline",
            "~/.local/bin/agent-box usage claude --statusline",
        }:
            status["command"] = "~/.local/bin/agent-box usage all --statusline"
            atomic_write_json(path, settings)
    except (OSError, ValueError, AttributeError):
        pass


def ensure_refresh_token() -> None:
    if not TOOLS_REFRESH_FILE.is_file() or TOOLS_REFRESH_FILE.stat().st_size == 0:
        atomic_write_text(TOOLS_REFRESH_FILE, "initial\n")


def build_image(script_dir: Path, refresh: bool, no_cache: bool) -> int:
    ensure_state_dirs()
    ensure_refresh_token()
    if refresh:
        now = datetime.now(timezone.utc)
        token = now.strftime("%Y%m%dT%H%M%S.") + f"{time.time_ns() % 1_000_000_000:09d}Z\n"
        atomic_write_text(TOOLS_REFRESH_FILE, token)
    args = [
        "podman", "build", "--format=oci", "--pull=always", "--layers",
        "--build-arg", "USER_NAME=rus364",
        "--build-arg", f"USER_UID={HOST_UID}",
        "--build-arg", f"USER_GID={HOST_GID}",
        "--build-arg", f"TOOLS_REFRESH={TOOLS_REFRESH_FILE.read_text().strip()}",
        "--tag", IMAGE, "--file", str(script_dir / "Containerfile"),
    ]
    if no_cache:
        args.append("--no-cache")
    args.append(str(script_dir))
    return subprocess.call(args)


def sync_claude_agent_skills() -> None:
    source = HOST_HOME / ".agents/skills"
    target_root = HOST_HOME / ".claude/skills"
    if not source.is_dir():
        return
    target_root.mkdir(parents=True, exist_ok=True)
    for skill in source.iterdir():
        if not (skill / "SKILL.md").is_file():
            continue
        target = target_root / skill.name
        if target.is_symlink():
            try:
                if target.resolve(strict=True) == skill.resolve(strict=True):
                    continue
            except OSError:
                pass
            warn(f"Claude skill '{skill.name}' already points elsewhere; keeping {target}")
        elif target.exists():
            warn(f"Claude skill '{skill.name}' already exists; keeping {target}")
        else:
            target.symlink_to(skill)
    for link in target_root.iterdir():
        if link.is_symlink() and os.readlink(link).startswith(str(source) + "/") and not link.exists():
            link.unlink(missing_ok=True)


def seed_state_dir(target: Path, *sources: Path) -> None:
    shutil.rmtree(target, ignore_errors=True)
    target.mkdir(parents=True, exist_ok=True)
    os.chmod(target, 0o700)
    for source in sources:
        if not source.exists():
            continue
        if source.is_dir():
            shutil.copytree(source, target, dirs_exist_ok=True, symlinks=True)
        else:
            shutil.copy2(source, target / "config")


def build_mounts(code_real: Path, script_dir: Path) -> list[str]:
    c = CONTAINER_HOME
    pairs: list[tuple[Path, Path, bool]] = [
        (code_real, c / "code", False),
        (HOST_HOME / ".codex", c / ".codex", False),
        (HOST_HOME / ".claude", c / ".claude", False),
        (STATE_ROOT / "cache", c / ".cache", False),
        (HOST_HOME / ".cache/claude-code", c / ".cache/claude-code", False),
        (HOST_HOME / ".cache/claude-cli-nodejs", c / ".cache/claude-cli-nodejs", False),
        (STATE_ROOT / "uv", c / ".local/share/uv", False),
        (STATE_ROOT / "mise", c / ".local/share/mise", False),
        (script_dir / "agent-box", c / ".local/bin/agent-box", True),
    ]
    if NOTIFY_CONFIG.is_file():
        pairs.append((NOTIFY_CONFIG, c / ".config/agent-box/telegram.json", True))
    if (HOST_HOME / ".claude.json").is_file():
        pairs.append((HOST_HOME / ".claude.json", c / ".claude.json", False))

    seed_state_dir(STATE_ROOT / "git", HOST_HOME / ".config/git", HOST_HOME / ".gitconfig")
    seed_state_dir(STATE_ROOT / "gh", HOST_HOME / ".config/gh")
    pairs += [(STATE_ROOT / "git", c / ".config/git", False), (STATE_ROOT / "gh", c / ".config/gh", False)]

    agents = HOST_HOME / ".agents"
    if agents.is_dir():
        pairs.append((agents, c / ".agents", True))
        seen: set[tuple[str, str]] = set()
        for link in agents.rglob("*"):
            if not link.is_symlink():
                continue
            try:
                host_target = link.resolve(strict=True)
            except OSError:
                warn(f"broken agent symlink: {link}")
                continue
            raw = os.readlink(link)
            container_target = Path(raw) if os.path.isabs(raw) else Path(os.path.normpath(str(link.parent / raw)))
            try:
                container_target.relative_to(c / ".agents")
                continue
            except ValueError:
                pass
            key = (str(host_target), str(container_target))
            if key not in seen:
                seen.add(key)
                pairs.append((host_target, container_target, True))

    out = []
    for src, dst, ro in pairs:
        spec = f"type=bind,src={src},dst={dst}" + (",ro=true" if ro else "")
        out += ["--mount", spec]
    return out


def kvm_args() -> list[str]:
    if os.environ.get("AGENT_BOX_KVM", "1") == "0" or not Path("/dev/kvm").exists():
        return []
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        warn("/dev/kvm exists but current user cannot access it; KVM disabled")
        return []
    args = ["--device=/dev/kvm"]
    try:
        runtime = subprocess.check_output(["podman", "info", "--format", "{{.Host.OCIRuntime.Name}}"], text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        runtime = ""
    if runtime == "crun":
        args.append("--group-add=keep-groups")
    else:
        warn(f"OCI runtime is {runtime or 'unknown'}; /dev/kvm will be passed through without keep-groups")
    return args


def maybe_gh_token() -> None:
    if os.environ.get("AGENT_BOX_GH_TOKEN", "1") == "0" or os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") or not shutil.which("gh"):
        return
    r = subprocess.run(["gh", "auth", "token"], text=True, capture_output=True)
    token = r.stdout.strip() if r.returncode == 0 else ""
    if token:
        os.environ["GH_TOKEN"] = token
    else:
        warn("no GitHub token on the host; run 'gh auth login' outside the container")


def run_args(code_real: Path, container_pwd: Path, script_dir: Path) -> list[str]:
    args = [
        "run", "--rm", "--interactive", "--userns=keep-id", *kvm_args(),
        "--cap-drop=all", "--security-opt=no-new-privileges", "--hostname=agent-box",
        f"--workdir={container_pwd}", f"--env=HOME={CONTAINER_HOME}",
        f"--env=PATH={CONTAINER_HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        f"--env=CODEX_HOME={CONTAINER_HOME}/.codex",
        f"--env=GIT_CONFIG_GLOBAL={CONTAINER_HOME}/.config/git/config",
        f"--env=GH_CONFIG_DIR={CONTAINER_HOME}/.config/gh",
        f"--env=XDG_CACHE_HOME={CONTAINER_HOME}/.cache",
        f"--env=UV_CACHE_DIR={CONTAINER_HOME}/.cache/uv",
        f"--env=MISE_DATA_DIR={CONTAINER_HOME}/.local/share/mise",
        "--env=DISABLE_AUTOUPDATER=1", f"--env=TERM={os.environ.get('TERM', 'xterm-256color')}",
        *build_mounts(code_real, script_dir),
    ]
    maybe_gh_token()
    for name in (
        "GH_TOKEN", "GITHUB_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
        "HTTP_PROXY", "HTTPS_PROXY", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS",
    ):
        if os.environ.get(name):
            args.append(f"--env={name}")
    if sys.stdin.isatty() and sys.stdout.isatty():
        args.append("--tty")
    return args


