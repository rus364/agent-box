#!/usr/bin/env bash
set -Eeuo pipefail

IMAGE="${AGENT_BOX_IMAGE:-localhost/agent-box:latest}"
DEFAULT_AGENT="${AGENT_BOX_AGENT:-claude}"

HOST_HOME="${HOME:?HOME is not set}"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

CONTAINER_HOME="/home/rus364"

CODE_LINK="${HOST_HOME}/code"
CODE_REAL="$(readlink -f -- "${CODE_LINK}")"

STATE_ROOT="${HOST_HOME}/.local/share/agent-box"
BUILD_STATE="${STATE_ROOT}/build"
TOOLS_REFRESH_FILE="${BUILD_STATE}/tools-refresh"

die() {
    printf 'agent-box: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'agent-box: warning: %s\n' "$*" >&2
}

usage() {
    cat <<'EOF'
Usage:
  agent-box [codex|claude] [agent arguments...]
  agent-box usage <codex|claude> [--statusline]
  agent-box usage all --statusline
  agent-box shell [bash arguments...]
  agent-box doctor
  agent-box build
  agent-box update
  agent-box rebuild

Environment:
  AGENT_BOX_AGENT   Default agent when claude/codex is omitted (default: claude)
  AGENT_BOX_IMAGE   Container image name (default: localhost/agent-box:latest)
  AGENT_BOX_KVM=0   Disable KVM passthrough
  AGENT_BOX_GH_TOKEN=0
                    Do not pass the host GitHub token in as GH_TOKEN

Examples:
  agent-box
  agent-box claude
  agent-box claude -p "summarize this repository"
  agent-box codex
  agent-box codex exec "inspect this repository"
  agent-box usage claude
  agent-box usage codex
  agent-box usage all --statusline
  AGENT_BOX_AGENT=codex agent-box
EOF
}

format_codex_usage() {
    jq -er '
      def compact_time($s):
        if $s >= 86400 then
          "\(($s / 86400) | floor)d\((($s % 86400) / 3600) | floor)h"
        elif $s >= 3600 then
          "\(($s / 3600) | floor)h\((($s % 3600) / 60) | floor)m"
        else
          "\(($s / 60) | floor)m"
        end;

      def remaining($w):
        if $w == null or $w.used_percent == null then "—"
        else ((100 - $w.used_percent) | floor | tostring)
        end;

      def reset($w):
        if $w == null or $w.reset_after_seconds == null then "—"
        else compact_time($w.reset_after_seconds)
        end;

      (.rate_limit // {}) as $r |
      ([$r.primary_window, $r.secondary_window] | map(select(. != null))) as $windows |
      ($windows | map(select(.limit_window_seconds != null and .limit_window_seconds <= 86400)) | first) as $short |
      ($windows | map(select(.limit_window_seconds != null and .limit_window_seconds > 86400)) | first) as $week |
      if ($short == null and $week == null) then
        error("response carried no recognizable rate-limit windows")
      else
        "\(remaining($short))/\(remaining($week)) · \(reset($short))/\(reset($week))"
      end
    '
}

agent_usage_codex() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/codex/usage.json"
    local cache_ttl="${CODEX_USAGE_CACHE_TTL:-60}"
    local auth="${CODEX_AUTH_PATH:-${CODEX_HOME:-$HOME/.codex}/auth.json}"
    local usage_url="${CODEX_USAGE_URL:-https://chatgpt.com/backend-api/wham/usage}"
    local dir tmp token account_id json

    if [[ -s "${cache}" ]] && (( $(date +%s) - $(stat -c %Y "${cache}") < cache_ttl )); then
        format_codex_usage < "${cache}"
        return
    fi

    if [[ ! -r "${auth}" ]]; then
        printf 'agent-box usage codex: authentication file not found: %s\n' "${auth}" >&2
        return 1
    fi

    token="$(jq -er '.tokens.access_token' "${auth}")" || {
        printf 'agent-box usage codex: access token not found in %s\n' "${auth}" >&2
        return 1
    }
    account_id="$(jq -r '.tokens.account_id // empty' "${auth}")"

    local curl_args=(
        --fail-with-body
        --silent
        --show-error
        --max-time 15
        --header "Authorization: Bearer ${token}"
    )

    if [[ -n "${account_id}" ]]; then
        curl_args+=(--header "chatgpt-account-id: ${account_id}")
    fi

    if json="$(curl "${curl_args[@]}" "${usage_url}")"; then
        dir="$(dirname -- "${cache}")"
        mkdir -p -- "${dir}"
        tmp="$(mktemp "${dir}/usage.XXXXXX")"
        jq -ec '.' <<< "${json}" >| "${tmp}"
        mv -- "${tmp}" "${cache}"
        format_codex_usage < "${cache}"
        return
    fi

    if [[ -s "${cache}" ]]; then
        printf 'agent-box usage codex: request failed; showing cached usage\n' >&2
        format_codex_usage < "${cache}"
    else
        return 1
    fi
}

normalize_claude_usage() {
    jq -c '
      def epoch:
        if type == "number" then .
        elif type == "string" then
          (sub("\\+00:00$"; "Z") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)
        else null
        end;

      def window($w):
        if $w == null then null
        else {
          used_percentage: ($w.used_percentage // $w.utilization),
          resets_at: ($w.resets_at | epoch)
        }
        end;

      if has("rate_limits") then
        {rate_limits}
      else
        {rate_limits: {
          five_hour: window(.five_hour),
          seven_day: window(.seven_day)
        }}
      end
    '
}

write_claude_usage_cache() {
    local cache="$1"
    local dir tmp
    dir="$(dirname -- "${cache}")"
    mkdir -p -- "${dir}"
    tmp="$(mktemp "${dir}/rate-limits.XXXXXX")"
    normalize_claude_usage >| "${tmp}"
    mv -- "${tmp}" "${cache}"
}

format_claude_usage() {
    jq -r --argjson now "$(date +%s)" '
      def valid($w):
        $w != null
        and $w.used_percentage != null
        and $w.resets_at != null
        and $w.resets_at > $now;

      def compact_time($s):
        if $s >= 86400 then
          "\(($s / 86400) | floor)d\((($s % 86400) / 3600) | floor)h"
        elif $s >= 3600 then
          "\(($s / 3600) | floor)h\((($s % 3600) / 60) | floor)m"
        else
          "\(($s / 60) | floor)m"
        end;

      def remaining($w):
        if valid($w) then ((100 - $w.used_percentage) | floor | tostring)
        else "—"
        end;

      def reset($w):
        if valid($w) then compact_time(($w.resets_at - $now) | floor)
        else "—"
        end;

      (.rate_limits // {}) as $r |
      "\(remaining($r.five_hour))/\(remaining($r.seven_day)) · \(reset($r.five_hour))/\(reset($r.seven_day))"
    '
}

agent_usage_claude() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/rate-limits.json"
    local credentials="${CLAUDE_CREDENTIALS_PATH:-$HOME/.claude/.credentials.json}"
    local usage_url="${CLAUDE_CODE_CUSTOM_OAUTH_URL:-https://api.anthropic.com}/api/oauth/usage"
    local cache_ttl="${CLAUDE_USAGE_CACHE_TTL:-60}"
    local input token response

    if [[ "${1:-}" == "--statusline" ]]; then
        input="$(cat)"

        if jq -e '.rate_limits != null' >/dev/null 2>&1 <<< "${input}"; then
            write_claude_usage_cache "${cache}" <<< "${input}"
        fi

        format_claude_usage <<< "${input}"
        return
    fi

    if [[ -s "${cache}" ]] && (( $(date +%s) - $(stat -c %Y "${cache}") < cache_ttl )); then
        format_claude_usage < "${cache}"
        return
    fi

    if [[ ! -r "${credentials}" ]]; then
        printf 'agent-box usage claude: OAuth credentials not found: %s\n' "${credentials}" >&2
    elif token="$(jq -er '.claudeAiOauth.accessToken' "${credentials}" 2>/dev/null)"; then
        if response="$(curl \
            --fail-with-body \
            --silent \
            --show-error \
            --max-time 15 \
            --header "Authorization: Bearer ${token}" \
            --header 'anthropic-beta: oauth-2025-04-20' \
            --header 'Content-Type: application/json' \
            --header 'User-Agent: claude-cli (external, cli)' \
            "${usage_url}")"; then
            write_claude_usage_cache "${cache}" <<< "${response}"
            format_claude_usage < "${cache}"
            return
        fi
    else
        printf 'agent-box usage claude: Claude Code subscription OAuth token not found\n' >&2
    fi

    if [[ -s "${cache}" ]]; then
        format_claude_usage < "${cache}"
    else
        printf '—/— · —/—\n'
    fi
}

agent_usage_all_statusline() {
    local input claude codex
    input="$(cat)"

    claude="$(agent_usage_claude --statusline <<< "${input}")" || claude='—/— · —/—'
    codex="$(agent_usage_codex 2>/dev/null)" || codex='—/— · —/—'

    printf 'Claude %s │ Codex %s\n' "${claude}" "${codex}"
}

case "${1:-}" in
    usage)
        shift
        provider="${1:-}"
        [[ -n "${provider}" ]] || die "usage provider required; expected codex, claude, or all"
        shift

        case "${provider}" in
            claude)
                if [[ "$#" -gt 1 || ( "$#" -eq 1 && "${1}" != "--statusline" ) ]]; then
                    die "agent-box usage claude accepts only --statusline"
                fi
                agent_usage_claude "$@"
                ;;
            codex)
                [[ "$#" -eq 0 ]] || die "agent-box usage codex takes no arguments"
                agent_usage_codex
                ;;
            all)
                [[ "$#" -eq 1 && "${1}" == "--statusline" ]] || die "agent-box usage all requires --statusline"
                agent_usage_all_statusline
                ;;
            *)
                die "unsupported usage provider '${provider}'; expected codex, claude, or all"
                ;;
        esac
        exit
        ;;
    help|-h|--help)
        usage
        exit
        ;;
esac

# Resolve this script even when called through a symlink such as:
# ~/.local/bin/agent-box -> ~/code/agent-box/agent-box
SOURCE="${BASH_SOURCE[0]}"

while [[ -L "${SOURCE}" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
    SOURCE="$(readlink -- "${SOURCE}")"

    if [[ "${SOURCE}" != /* ]]; then
        SOURCE="${SOURCE_DIR}/${SOURCE}"
    fi
done

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
CONTAINERFILE="${SCRIPT_DIR}/Containerfile"

command -v podman >/dev/null 2>&1 || die "podman not found"

[[ -d "${CODE_REAL}" ]] || die "code directory does not exist: ${CODE_LINK}"
[[ -f "${CONTAINERFILE}" ]] || die "Containerfile not found: ${CONTAINERFILE}"

# Persistent state.
mkdir -p \
    "${BUILD_STATE}" \
    "${STATE_ROOT}/cache" \
    "${STATE_ROOT}/uv" \
    "${STATE_ROOT}/mise" \
    "${STATE_ROOT}/git" \
    "${STATE_ROOT}/gh" \
    "${HOST_HOME}/.codex" \
    "${HOST_HOME}/.claude" \
    "${HOST_HOME}/.cache/claude-code" \
    "${HOST_HOME}/.cache/claude-cli-nodejs"

# Migrate legacy/single-provider status lines to the combined usage line.
CLAUDE_SETTINGS="${HOST_HOME}/.claude/settings.json"
if [[ -f "${CLAUDE_SETTINGS}" ]] && command -v jq >/dev/null 2>&1; then
    old_statusline="$(jq -r '.statusLine.command // empty' "${CLAUDE_SETTINGS}" 2>/dev/null || true)"
    if [[ "${old_statusline}" == "~/.local/bin/claude-usage --statusline" || \
          "${old_statusline}" == "~/.local/bin/agent-box usage claude --statusline" ]]; then
        settings_tmp="$(mktemp "${CLAUDE_SETTINGS}.XXXXXX")"
        jq '.statusLine.command = "~/.local/bin/agent-box usage all --statusline"' \
            "${CLAUDE_SETTINGS}" >| "${settings_tmp}"
        mv -- "${settings_tmp}" "${CLAUDE_SETTINGS}"
    fi
fi

# The refresh token is persistent. Therefore an update followed by a regular
# build cannot accidentally return to an older cached TOOLS_REFRESH layer.
if [[ ! -s "${TOOLS_REFRESH_FILE}" ]]; then
    printf '%s\n' initial >| "${TOOLS_REFRESH_FILE}"
fi

new_tools_refresh_token() {
    date -u '+%Y%m%dT%H%M%S.%NZ'
}

build_image() {
    local refresh="${1:-false}"
    local no_cache="${2:-false}"

    if [[ "${refresh}" == "true" ]]; then
        new_tools_refresh_token >| "${TOOLS_REFRESH_FILE}"
    fi

    local tools_refresh
    tools_refresh="$(<"${TOOLS_REFRESH_FILE}")"

    local args=(
        build
        --format=oci
        --pull=always
        --layers
        --build-arg "USER_NAME=rus364"
        --build-arg "USER_UID=${HOST_UID}"
        --build-arg "USER_GID=${HOST_GID}"
        --build-arg "TOOLS_REFRESH=${tools_refresh}"
        --tag "${IMAGE}"
        --file "${CONTAINERFILE}"
    )

    if [[ "${no_cache}" == "true" ]]; then
        args+=(--no-cache)
    fi

    podman "${args[@]}" "${SCRIPT_DIR}"
}

# Image management commands do not require being inside ~/code.
case "${1:-}" in
    build)
        build_image false false
        exit
        ;;
    update)
        build_image true false
        exit
        ;;
    rebuild)
        build_image true true
        exit
        ;;
esac

# Auto-build on first use.
if ! podman image exists "${IMAGE}"; then
    printf 'agent-box: image not found; building it...\n' >&2
    build_image false false
fi

# Keep ~/.agents/skills as the canonical shared skill set. Codex discovers
# skills there directly, while Claude Code discovers personal skills from
# ~/.claude/skills. Create only missing Claude links and never overwrite an
# existing Claude-specific skill with the same name.
sync_claude_agent_skills() {
    local agent_skills="${HOST_HOME}/.agents/skills"
    local claude_skills="${HOST_HOME}/.claude/skills"

    [[ -d "${agent_skills}" ]] || return 0

    mkdir -p -- "${claude_skills}"

    local skill name claude_skill source_real claude_real

    while IFS= read -r -d '' skill; do
        [[ -f "${skill}/SKILL.md" ]] || continue

        name="$(basename -- "${skill}")"
        claude_skill="${claude_skills}/${name}"

        if [[ -L "${claude_skill}" ]]; then
            source_real="$(readlink -f -- "${skill}" 2>/dev/null || true)"
            claude_real="$(readlink -f -- "${claude_skill}" 2>/dev/null || true)"

            if [[ -n "${source_real}" && "${claude_real}" == "${source_real}" ]]; then
                continue
            fi

            warn "Claude skill '${name}' already points elsewhere; keeping ${claude_skill}"
            continue
        fi

        if [[ -e "${claude_skill}" ]]; then
            warn "Claude skill '${name}' already exists; keeping ${claude_skill}"
            continue
        fi

        ln -s -- "${skill}" "${claude_skill}"
    done < <(find "${agent_skills}" -mindepth 1 -maxdepth 1 -print0)

    while IFS= read -r -d '' claude_skill; do
        case "$(readlink -- "${claude_skill}")" in
            "${agent_skills}/"*)
                if [[ ! -e "${claude_skill}" ]]; then
                    rm -f -- "${claude_skill}"
                fi
                ;;
        esac
    done < <(find "${claude_skills}" -mindepth 1 -maxdepth 1 -type l -print0)
}

sync_claude_agent_skills

# Workdir mapping.
PWD_REAL="$(readlink -f -- "${PWD}")"

case "${PWD_REAL}" in
    "${CODE_REAL}")
        RELATIVE=""
        ;;
    "${CODE_REAL}"/*)
        RELATIVE="${PWD_REAL#"${CODE_REAL}"}"
        ;;
    *)
        die "must be started from ${CODE_LINK} (current physical path: ${PWD_REAL})"
        ;;
esac

CONTAINER_CODE="${CONTAINER_HOME}/code"
CONTAINER_PWD="${CONTAINER_CODE}${RELATIVE}"

# ---------------------------------------------------------------------------
# Bind mounts
# ---------------------------------------------------------------------------

MOUNTS=(
    --mount
    "type=bind,src=${CODE_REAL},dst=${CONTAINER_CODE}"

    --mount
    "type=bind,src=${HOST_HOME}/.codex,dst=${CONTAINER_HOME}/.codex"

    --mount
    "type=bind,src=${HOST_HOME}/.claude,dst=${CONTAINER_HOME}/.claude"

    --mount
    "type=bind,src=${STATE_ROOT}/cache,dst=${CONTAINER_HOME}/.cache"

    --mount
    "type=bind,src=${HOST_HOME}/.cache/claude-code,dst=${CONTAINER_HOME}/.cache/claude-code"

    --mount
    "type=bind,src=${HOST_HOME}/.cache/claude-cli-nodejs,dst=${CONTAINER_HOME}/.cache/claude-cli-nodejs"

    --mount
    "type=bind,src=${STATE_ROOT}/uv,dst=${CONTAINER_HOME}/.local/share/uv"

    --mount
    "type=bind,src=${STATE_ROOT}/mise,dst=${CONTAINER_HOME}/.local/share/mise"

    # Claude statusLine runs inside the container. Expose this launcher there
    # so it can call the integrated usage command without helper scripts.
    --mount
    "type=bind,src=${SCRIPT_DIR}/agent-box,dst=${CONTAINER_HOME}/.local/bin/agent-box,ro=true"
)

if [[ -f "${HOST_HOME}/.claude.json" ]]; then
    MOUNTS+=(
        --mount
        "type=bind,src=${HOST_HOME}/.claude.json,dst=${CONTAINER_HOME}/.claude.json"
    )
fi

# ---------------------------------------------------------------------------
# Git and GitHub CLI configuration
# ---------------------------------------------------------------------------
seed_state_dir() {
    local state_dir="$1"
    shift

    rm -rf -- "${state_dir}"
    mkdir -p -- "${state_dir}"
    chmod 700 -- "${state_dir}"

    local source
    for source in "$@"; do
        [[ -e "${source}" ]] || continue

        if [[ -d "${source}" ]]; then
            cp -a -- "${source}/." "${state_dir}/"
        else
            cp -a -- "${source}" "${state_dir}/config"
        fi
    done
}

seed_state_dir \
    "${STATE_ROOT}/git" \
    "${HOST_HOME}/.config/git" \
    "${HOST_HOME}/.gitconfig"

seed_state_dir \
    "${STATE_ROOT}/gh" \
    "${HOST_HOME}/.config/gh"

MOUNTS+=(
    --mount
    "type=bind,src=${STATE_ROOT}/git,dst=${CONTAINER_HOME}/.config/git"

    --mount
    "type=bind,src=${STATE_ROOT}/gh,dst=${CONTAINER_HOME}/.config/gh"
)

# ---------------------------------------------------------------------------
# ~/.agents
# ---------------------------------------------------------------------------
if [[ -d "${HOST_HOME}/.agents" ]]; then
    MOUNTS+=(
        --mount
        "type=bind,src=${HOST_HOME}/.agents,dst=${CONTAINER_HOME}/.agents,ro=true"
    )

    declare -A SEEN_TARGETS=()

    while IFS= read -r -d '' LINK; do
        RAW_TARGET="$(readlink -- "${LINK}")"
        HOST_TARGET="$(readlink -f -- "${LINK}" 2>/dev/null || true)"

        if [[ -z "${HOST_TARGET}" || ! -e "${HOST_TARGET}" ]]; then
            warn "broken agent symlink: ${LINK}"
            continue
        fi

        if [[ "${RAW_TARGET}" == /* ]]; then
            CONTAINER_TARGET="${RAW_TARGET%/}"
        else
            CONTAINER_TARGET="$(realpath -m -- "$(dirname -- "${LINK}")/${RAW_TARGET}")"
        fi

        case "${CONTAINER_TARGET}" in
            "${CONTAINER_HOME}/.agents"|"${CONTAINER_HOME}/.agents/"*)
                continue
                ;;
        esac

        KEY="${HOST_TARGET}|${CONTAINER_TARGET}"

        if [[ -n "${SEEN_TARGETS[${KEY}]+x}" ]]; then
            continue
        fi

        SEEN_TARGETS["${KEY}"]=1

        MOUNTS+=(
            --mount
            "type=bind,src=${HOST_TARGET},dst=${CONTAINER_TARGET},ro=true"
        )
    done < <(find "${HOST_HOME}/.agents" -type l -print0)
fi

# ---------------------------------------------------------------------------
# QEMU / KVM
# ---------------------------------------------------------------------------
DEVICE_ARGS=()

if [[ "${AGENT_BOX_KVM:-1}" != "0" && -e /dev/kvm ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        DEVICE_ARGS+=(--device=/dev/kvm)

        OCI_RUNTIME="$(podman info --format '{{.Host.OCIRuntime.Name}}')"

        if [[ "${OCI_RUNTIME}" == "crun" ]]; then
            DEVICE_ARGS+=(--group-add=keep-groups)
        else
            warn "OCI runtime is ${OCI_RUNTIME}; /dev/kvm will be passed through without keep-groups"
        fi
    else
        warn "/dev/kvm exists but current user cannot access it; KVM disabled"
    fi
fi

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
RUN_ARGS=(
    run
    --rm
    --interactive
    --userns=keep-id
    "${DEVICE_ARGS[@]}"
    --cap-drop=all
    --security-opt=no-new-privileges
    --hostname=agent-box
    --workdir="${CONTAINER_PWD}"
    --env="HOME=${CONTAINER_HOME}"
    --env="PATH=${CONTAINER_HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    --env="CODEX_HOME=${CONTAINER_HOME}/.codex"
    --env="GIT_CONFIG_GLOBAL=${CONTAINER_HOME}/.config/git/config"
    --env="GH_CONFIG_DIR=${CONTAINER_HOME}/.config/gh"
    --env="XDG_CACHE_HOME=${CONTAINER_HOME}/.cache"
    --env="UV_CACHE_DIR=${CONTAINER_HOME}/.cache/uv"
    --env="MISE_DATA_DIR=${CONTAINER_HOME}/.local/share/mise"
    --env="DISABLE_AUTOUPDATER=1"
    --env="TERM=${TERM:-xterm-256color}"
    "${MOUNTS[@]}"
)

if [[ "${AGENT_BOX_GH_TOKEN:-1}" != "0" && -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
    if command -v gh >/dev/null 2>&1; then
        HOST_GH_TOKEN="$(gh auth token 2>/dev/null || true)"

        if [[ -n "${HOST_GH_TOKEN}" ]]; then
            export GH_TOKEN="${HOST_GH_TOKEN}"
        else
            warn "no GitHub token on the host; run 'gh auth login' outside the container"
        fi

        unset HOST_GH_TOKEN
    fi
fi

for env_name in \
    GH_TOKEN \
    GITHUB_TOKEN \
    ANTHROPIC_API_KEY \
    ANTHROPIC_AUTH_TOKEN \
    ANTHROPIC_BASE_URL \
    CLAUDE_CODE_USE_BEDROCK \
    CLAUDE_CODE_USE_VERTEX \
    HTTP_PROXY \
    HTTPS_PROXY \
    SSL_CERT_FILE \
    NODE_EXTRA_CA_CERTS; do
    if [[ -n "${!env_name:-}" ]]; then
        RUN_ARGS+=(--env="${env_name}")
    fi
done

if [[ -t 0 && -t 1 ]]; then
    RUN_ARGS+=(--tty)
fi

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
case "${1:-}" in
    shell)
        shift
        exec podman "${RUN_ARGS[@]}" "${IMAGE}" bash --login "$@"
        ;;

    doctor)
        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            bash -c '
                set -u

                printf "%-20s %s\n" "architecture:" "$(uname -m)"
                printf "%-20s %s\n" "user:" "$(id)"
                printf "%-20s %s\n" "workdir:" "$PWD"
                printf "%-20s %s\n" "claude:" "$(claude --version)"
                printf "%-20s %s\n" "codex:" "$(codex --version)"
                printf "%-20s %s\n" "python:" "$(python --version 2>&1)"
                printf "%-20s %s\n" "uv:" "$(uv --version)"
                printf "%-20s %s\n" "mise:" "$(mise --version)"
                printf "%-20s %s\n" "git:" "$(git --version)"
                printf "%-20s %s\n" "git user:" "$(git config --global user.name) <$(git config --global user.email)>"
                printf "%-20s %s\n" "gh:" "$(gh --version | head -1)"
                printf "%-20s %s\n" "gh account:" "$(gh api user --jq .login 2>/dev/null || echo "not authenticated")"
                printf "%-20s %s\n" "yq:" "$(yq --version)"
                printf "%-20s %s\n" "kubectl:" "$(kubectl version --client 2>/dev/null | head -1)"
                printf "%-20s %s\n" "helm:" "$(helm version --short)"
                printf "%-20s %s\n" "qemu-x86:" "$(qemu-system-x86_64 --version | head -1)"
                printf "%-20s %s\n" "qemu-arm64:" "$(qemu-system-aarch64 --version | head -1)"

                echo

                if [[ -r /dev/kvm && -w /dev/kvm ]]; then
                    echo "KVM device:          usable"

                    rc=0
                    timeout 2 \
                        qemu-system-x86_64 \
                        -accel kvm \
                        -machine none \
                        -nodefaults \
                        -display none \
                        >/dev/null 2>&1 || rc=$?

                    if [[ "${rc}" -eq 124 ]]; then
                        echo "amd64 KVM:           OK"
                    else
                        echo "amd64 KVM:           FAILED (rc=${rc})"
                    fi
                else
                    echo "KVM device:          unavailable"
                fi

                rc=0
                timeout 2 \
                    qemu-system-aarch64 \
                    -accel tcg \
                    -machine virt \
                    -cpu max \
                    -S \
                    -nodefaults \
                    -display none \
                    >/dev/null 2>&1 || rc=$?

                if [[ "${rc}" -eq 124 ]]; then
                    echo "arm64 TCG:           OK"
                else
                    echo "arm64 TCG:           FAILED (rc=${rc})"
                fi

                echo

                if [[ -d "$HOME/.agents/skills" ]]; then
                    broken=0
                    shared=0

                    while IFS= read -r -d "" link; do
                        if [[ ! -e "${link}" ]]; then
                            echo "BROKEN agent skill: ${link} -> $(readlink "${link}")"
                            broken=1
                        fi
                    done < <(find "$HOME/.agents/skills" -maxdepth 1 -type l -print0)

                    while IFS= read -r -d "" skill; do
                        [[ -f "${skill}/SKILL.md" ]] || continue

                        name="$(basename -- "${skill}")"
                        claude_skill="$HOME/.claude/skills/${name}"

                        if [[ ! -f "${claude_skill}/SKILL.md" ]]; then
                            echo "MISSING Claude skill: ${claude_skill}"
                            broken=1
                            continue
                        fi

                        agent_real="$(readlink -f -- "${skill}")"
                        claude_real="$(readlink -f -- "${claude_skill}")"

                        if [[ "${agent_real}" != "${claude_real}" ]]; then
                            echo "MISMATCH Claude skill: ${claude_skill} -> ${claude_real} (expected ${agent_real})"
                            broken=1
                            continue
                        fi

                        shared=$((shared + 1))
                    done < <(find "$HOME/.agents/skills" -mindepth 1 -maxdepth 1 -print0)

                    if [[ "${broken}" -eq 0 ]]; then
                        echo "shared agent skills: OK (${shared})"
                    fi
                fi
            '
        ;;
esac

agent="${DEFAULT_AGENT}"

case "${1:-}" in
    claude|codex)
        agent="$1"
        shift
        ;;
esac

case "${agent}" in
    claude)
        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            claude \
            --dangerously-skip-permissions \
            "$@"
        ;;
    codex)
        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            codex \
            --dangerously-bypass-approvals-and-sandbox \
            "$@"
        ;;
    *)
        die "unsupported agent '${agent}'; expected claude or codex"
        ;;
esac