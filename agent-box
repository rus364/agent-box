def selftest() -> None:
    n = 0
    def check(actual: Any, expected: Any, label: str) -> None:
        nonlocal n
        n += 1
        if actual != expected:
            raise AssertionError(f"{label}: expected {expected!r}, got {actual!r}")
    check(compact_time(3660), "1h1m", "duration")
    check(compact_time(176400), "2d1h", "duration days")
    check(format_codex_usage({"rate_limit": {
        "primary_window": {"used_percent": 25, "limit_window_seconds": 18000, "reset_after_seconds": 3660},
        "secondary_window": {"used_percent": 40, "limit_window_seconds": 604800, "reset_after_seconds": 176400},
    }}), "75/60 · 1h1m/2d1h", "codex windows")
    check(format_codex_usage({"rate_limit": {
        "primary_window": {"used_percent": 100, "limit_window_seconds": 604800, "reset_after_seconds": 385907},
        "secondary_window": None,
    }}), "—/0 · —/4d11h", "codex weekly")
    now = 1_800_000_000
    check(format_claude_usage({"rate_limits": {
        "five_hour": {"used_percentage": 25, "resets_at": now + 3660},
        "seven_day": {"used_percentage": 40, "resets_at": now + 176400},
    }}, now), "75/60 · 1h1m/2d1h", "claude windows")
    check(notify_project("/tmp/project"), "project", "project")
    check(notify_project("/"), "unknown", "root project")
    check(parse_payload("bad"), {}, "bad json")
    print(f"agent-box: {n} self-tests passed")


def runtime_main(args: list[str], script_dir: Path) -> None:
    if not shutil.which("podman"):
        die("podman not found")
    try:
        code_real = CODE_LINK.resolve(strict=True)
    except OSError:
        die(f"code directory does not exist: {CODE_LINK}")
    if not code_real.is_dir():
        die(f"code directory does not exist: {CODE_LINK}")
    if not (script_dir / "Containerfile").is_file():
        die(f"Containerfile not found: {script_dir / 'Containerfile'}")
    ensure_state_dirs()
    migrate_statusline()
    ensure_refresh_token()

    if subprocess.run(["podman", "image", "exists", IMAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        print("agent-box: image not found; building it...", file=sys.stderr)
        rc = build_image(script_dir, False, False)
        if rc:
            raise SystemExit(rc)

    sync_claude_agent_skills()
    pwd_real = Path.cwd().resolve()
    try:
        relative = pwd_real.relative_to(code_real)
    except ValueError:
        die(f"must be started from {CODE_LINK} (current physical path: {pwd_real})")
    container_pwd = CONTAINER_HOME / "code" / relative
    podman = run_args(code_real, container_pwd, script_dir)

    if args and args[0] == "shell":
        os.execvp("podman", ["podman", *podman, IMAGE, "bash", "--login", *args[1:]])
    if args and args[0] == "doctor":
        os.execvp("podman", ["podman", *podman, IMAGE, "bash", "-c", DOCTOR_SCRIPT])

    agent, rest = DEFAULT_AGENT, args
    if args and args[0] in {"claude", "codex"}:
        agent, rest = args[0], args[1:]
    if agent == "claude":
        cmd = ["podman", *podman, IMAGE, "claude", "--dangerously-skip-permissions", *rest]
    elif agent == "codex":
        notify = ["-c", 'notify=["/home/rus364/.local/bin/agent-box","notify","codex"]'] if NOTIFY_CONFIG.is_file() else []
        cmd = ["podman", *podman, IMAGE, "codex", *notify, "--dangerously-bypass-approvals-and-sandbox", *rest]
    else:
        die(f"unsupported agent '{agent}'; expected claude or codex")
    os.execvp("podman", cmd)


def main() -> None:
    args = sys.argv[1:]
    script_dir = Path(__file__).resolve().parent
    try:
        if args and args[0] == "usage":
            usage_command(args[1:]); return
        if args and args[0] == "notify":
            notify_command(args[1:]); return
        if args and args[0] == "selftest":
            if len(args) != 1: die("agent-box selftest takes no arguments")
            selftest(); return
        if args and args[0] in {"help", "-h", "--help"}:
            usage(); return
        if args and args[0] in {"build", "update", "rebuild"}:
            if len(args) != 1: die(f"agent-box {args[0]} takes no arguments")
            if not shutil.which("podman"): die("podman not found")
            command = args[0]
            raise SystemExit(build_image(script_dir, command != "build", command == "rebuild"))
        runtime_main(args, script_dir)
    except AgentBoxError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        raise SystemExit(130)


if __name__ == "__main__":
    main()
