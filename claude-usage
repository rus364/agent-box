#!/usr/bin/env bash
set -euo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/rate-limits.json"
CREDENTIALS="${CLAUDE_CREDENTIALS_PATH:-$HOME/.claude/.credentials.json}"
USAGE_URL="${CLAUDE_CODE_CUSTOM_OAUTH_URL:-https://api.anthropic.com}/api/oauth/usage"
CACHE_TTL=60

normalize_usage() {
  jq -c '
    def epoch:
      if type == "number" then .
      elif type == "string" then
        (sub("\\+00:00$"; "Z") | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)
      else null
      end;

    def window($w):
      if $w == null then null
      else {
        used_percentage: ($w.used_percentage // $w.utilization),
        resets_at: ($w.resets_at | epoch)
      }
      end;

    if has("rate_limits") then
      {rate_limits}
    else
      {rate_limits: {
        five_hour: window(.five_hour),
        seven_day: window(.seven_day)
      }}
    end
  '
}

write_cache() {
  local dir tmp
  dir="$(dirname "$CACHE")"
  mkdir -p "$dir"
  tmp="$(mktemp "${dir}/rate-limits.XXXXXX")"
  normalize_usage >| "$tmp"
  mv "$tmp" "$CACHE"
}

format_usage() {
  jq -r --argjson now "$(date +%s)" '
    def valid($w):
      $w != null
      and $w.used_percentage != null
      and $w.resets_at != null
      and $w.resets_at > $now;

    def compact_time($s):
      if $s >= 86400 then
        "\(($s / 86400) | floor)d\((($s % 86400) / 3600) | floor)h"
      elif $s >= 3600 then
        "\(($s / 3600) | floor)h\((($s % 3600) / 60) | floor)m"
      else
        "\(($s / 60) | floor)m"
      end;

    def remaining($w):
      if valid($w) then
        ((100 - $w.used_percentage) | floor | tostring)
      else
        "—"
      end;

    def reset($w):
      if valid($w) then
        compact_time(($w.resets_at - $now) | floor)
      else
        "—"
      end;

    (.rate_limits // {}) as $r |
    "\(remaining($r.five_hour))/\(remaining($r.seven_day)) · \(reset($r.five_hour))/\(reset($r.seven_day))"
  '
}

if [[ "${1:-}" == "--statusline" ]]; then
  input="$(cat)"

  if jq -e '.rate_limits != null' >/dev/null 2>&1 <<< "$input"; then
    write_cache <<< "$input"
  fi

  format_usage <<< "$input"
  exit
fi

if [[ -s "$CACHE" ]] && (( $(date +%s) - $(stat -c %Y "$CACHE") < CACHE_TTL )); then
  format_usage < "$CACHE"
  exit
fi

if [[ ! -r "$CREDENTIALS" ]]; then
  echo "claude-usage: OAuth credentials not found: $CREDENTIALS" >&2
elif token="$(jq -er '.claudeAiOauth.accessToken' "$CREDENTIALS" 2>/dev/null)"; then
  if response="$(curl \
    --fail-with-body \
    --silent \
    --show-error \
    --max-time 15 \
    --header "Authorization: Bearer ${token}" \
    --header 'anthropic-beta: oauth-2025-04-20' \
    --header 'Content-Type: application/json' \
    --header 'User-Agent: claude-cli (external, cli)' \
    "$USAGE_URL")"; then
    write_cache <<< "$response"
    format_usage < "$CACHE"
    exit
  fi
else
  echo "claude-usage: Claude Code subscription OAuth token not found" >&2
fi

if [[ -s "$CACHE" ]]; then
  format_usage < "$CACHE"
else
  echo "—/— · —/—"
fi
