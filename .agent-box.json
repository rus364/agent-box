{
  "tracker": {
    "connections": {
      "github": {
        "url": "https://api.github.com"
      }
    },
    "project": "rus364/2",
    "provider": "github",
    "recursive": false
  },
  "version": 2,
  "workflow": {
    "auto_push": true,
    "cleanup_local_branches": true,
    "cleanup_remote_branches": true,
    "merge_mode": "local",
    "review": {
      "ignored_paths": [
        "docs/**",
        "**/*.md"
      ],
      "sensitive_paths": [
        "**/skills/**",
        "**/AGENTS.md",
        "**/config*",
        ".github/**",
        "agent_box/paths.py",
        "agent_box/runtime.py",
        "agent_box/notify.py",
        "agent_box/tracker/*_api.py",
        "pyproject.toml",
        "agent_box/Containerfile",
        "agent_box/runtime_bundle.py",
        "agent_box/container-launcher",
        "agent_box/__main__.py"
      ]
    }
  }
}
