#!/usr/bin/env bash
set -Eeuo pipefail

IMAGE="${CODEX_BOX_IMAGE:-localhost/codex-box:latest}"

HOST_HOME="${HOME:?HOME is not set}"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

CONTAINER_HOME="/home/rus364"

CODE_LINK="${HOST_HOME}/code"
CODE_REAL="$(readlink -f -- "${CODE_LINK}")"

STATE_ROOT="${HOST_HOME}/.local/share/codex-box"
BUILD_STATE="${STATE_ROOT}/build"
TOOLS_REFRESH_FILE="${BUILD_STATE}/tools-refresh"

die() {
    printf 'codex-box: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'codex-box: warning: %s\n' "$*" >&2
}

#
# Resolve this script even when called through:
# ~/.local/bin/codex-box -> ~/code/codex-box/codex-box
#
SOURCE="${BASH_SOURCE[0]}"

while [[ -L "${SOURCE}" ]]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
    SOURCE="$(readlink -- "${SOURCE}")"

    if [[ "${SOURCE}" != /* ]]; then
        SOURCE="${SOURCE_DIR}/${SOURCE}"
    fi
done

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${SOURCE}")" && pwd)"
CONTAINERFILE="${SCRIPT_DIR}/Containerfile"

command -v podman >/dev/null 2>&1 ||
    die "podman not found"

[[ -d "${CODE_REAL}" ]] ||
    die "code directory does not exist: ${CODE_LINK}"

[[ -f "${CONTAINERFILE}" ]] ||
    die "Containerfile not found: ${CONTAINERFILE}"

#
# Persistent state.
#
mkdir -p \
    "${BUILD_STATE}" \
    "${STATE_ROOT}/cache" \
    "${STATE_ROOT}/uv" \
    "${STATE_ROOT}/mise" \
    "${HOST_HOME}/.codex"

#
# IMPORTANT:
#
# The refresh token is persistent.
#
# Therefore:
#
#   codex-box update
#   codex-box build
#
# cannot accidentally return to an old cached TOOLS_REFRESH=initial layer.
#
if [[ ! -s "${TOOLS_REFRESH_FILE}" ]]; then
    printf '%s\n' initial >| "${TOOLS_REFRESH_FILE}"
fi

new_tools_refresh_token() {
    date -u '+%Y%m%dT%H%M%S.%NZ'
}

build_image() {
    local refresh="${1:-false}"
    local no_cache="${2:-false}"

    if [[ "${refresh}" == "true" ]]; then
        new_tools_refresh_token >| "${TOOLS_REFRESH_FILE}"
    fi

    local tools_refresh
    tools_refresh="$(<"${TOOLS_REFRESH_FILE}")"

    local args=(
        build

        --format=oci
        --pull=always
        --layers

        --build-arg "USER_NAME=rus364"
        --build-arg "USER_UID=${HOST_UID}"
        --build-arg "USER_GID=${HOST_GID}"
        --build-arg "TOOLS_REFRESH=${tools_refresh}"

        --tag "${IMAGE}"
        --file "${CONTAINERFILE}"
    )

    if [[ "${no_cache}" == "true" ]]; then
        args+=(--no-cache)
    fi

    podman "${args[@]}" "${SCRIPT_DIR}"
}

#
# Image management commands do not require being inside ~/code.
#
case "${1:-}" in
    build)
        build_image false false
        exit
        ;;

    update)
        build_image true false
        exit
        ;;

    rebuild)
        build_image true true
        exit
        ;;
esac

#
# Auto-build on first use.
#
if ! podman image exists "${IMAGE}"; then
    printf 'codex-box: image not found; building it...\n' >&2
    build_image false false
fi

#
# Workdir mapping.
#
# Host:
#
#   /home/rus364/code -> /home/rus364/.local/src
#
# Container always sees:
#
#   /home/rus364/code/...
#
PWD_REAL="$(readlink -f -- "${PWD}")"

case "${PWD_REAL}" in
    "${CODE_REAL}")
        RELATIVE=""
        ;;

    "${CODE_REAL}"/*)
        RELATIVE="${PWD_REAL#"${CODE_REAL}"}"
        ;;

    *)
        die "must be started from ${CODE_LINK} (current physical path: ${PWD_REAL})"
        ;;
esac

CONTAINER_CODE="${CONTAINER_HOME}/code"
CONTAINER_PWD="${CONTAINER_CODE}${RELATIVE}"

#
# ---------------------------------------------------------------------------
# Bind mounts
# ---------------------------------------------------------------------------
#

MOUNTS=(
    #
    # All code is intentionally writable.
    #
    --mount
    "type=bind,src=${CODE_REAL},dst=${CONTAINER_CODE}"

    #
    # Codex config/auth/history from host.
    #
    --mount
    "type=bind,src=${HOST_HOME}/.codex,dst=${CONTAINER_HOME}/.codex"

    #
    # Persistent disposable-container state.
    #
    --mount
    "type=bind,src=${STATE_ROOT}/cache,dst=${CONTAINER_HOME}/.cache"

    --mount
    "type=bind,src=${STATE_ROOT}/uv,dst=${CONTAINER_HOME}/.local/share/uv"

    --mount
    "type=bind,src=${STATE_ROOT}/mise,dst=${CONTAINER_HOME}/.local/share/mise"
)

#
# Git configuration is readable but immutable from the container.
#
if [[ -f "${HOST_HOME}/.gitconfig" ]]; then
    MOUNTS+=(
        --mount
        "type=bind,src=${HOST_HOME}/.gitconfig,dst=${CONTAINER_HOME}/.gitconfig,ro=true"
    )
fi

if [[ -d "${HOST_HOME}/.config/git" ]]; then
    MOUNTS+=(
        --mount
        "type=bind,src=${HOST_HOME}/.config/git,dst=${CONTAINER_HOME}/.config/git,ro=true"
    )
fi

#
# ---------------------------------------------------------------------------
# ~/.agents
# ---------------------------------------------------------------------------
#
# ~/.agents itself is read-only.
#
# Skills may be absolute symlinks pointing outside ~/.agents, e.g.
#
#   ~/.local/share/codex-skill-sources/...
#   /mnt/data/tools/Hermes/...
#
# Mount each resolved target read-only at the path expected by the symlink.
#

if [[ -d "${HOST_HOME}/.agents" ]]; then
    MOUNTS+=(
        --mount
        "type=bind,src=${HOST_HOME}/.agents,dst=${CONTAINER_HOME}/.agents,ro=true"
    )

    declare -A SEEN_TARGETS=()

    while IFS= read -r -d '' LINK; do
        RAW_TARGET="$(readlink -- "${LINK}")"
        HOST_TARGET="$(readlink -f -- "${LINK}" 2>/dev/null || true)"

        if [[ -z "${HOST_TARGET}" || ! -e "${HOST_TARGET}" ]]; then
            warn "broken agent symlink: ${LINK}"
            continue
        fi

        if [[ "${RAW_TARGET}" == /* ]]; then
            CONTAINER_TARGET="${RAW_TARGET%/}"
        else
            CONTAINER_TARGET="$(
                realpath -m -- "$(dirname -- "${LINK}")/${RAW_TARGET}"
            )"
        fi

        #
        # Already covered by ~/.agents itself.
        #
        case "${CONTAINER_TARGET}" in
            "${CONTAINER_HOME}/.agents"|"${CONTAINER_HOME}/.agents/"*)
                continue
                ;;
        esac

        KEY="${HOST_TARGET}|${CONTAINER_TARGET}"

        if [[ -n "${SEEN_TARGETS[${KEY}]+x}" ]]; then
            continue
        fi

        SEEN_TARGETS["${KEY}"]=1

        MOUNTS+=(
            --mount
            "type=bind,src=${HOST_TARGET},dst=${CONTAINER_TARGET},ro=true"
        )
    done < <(
        find "${HOST_HOME}/.agents" -type l -print0
    )
fi

#
# ---------------------------------------------------------------------------
# QEMU / KVM
# ---------------------------------------------------------------------------
#
# amd64:
#     qemu-system-x86_64 + /dev/kvm
#
# arm64:
#     qemu-system-aarch64 + TCG
#
# CODEX_BOX_KVM=0 explicitly disables KVM passthrough.
#

DEVICE_ARGS=()

if [[ "${CODEX_BOX_KVM:-1}" != "0" && -e /dev/kvm ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        DEVICE_ARGS+=(
            --device=/dev/kvm
        )

        OCI_RUNTIME="$(
            podman info --format '{{.Host.OCIRuntime.Name}}'
        )"

        #
        # keep-groups is supported by crun and preserves host supplementary
        # groups, e.g. the kvm group.
        #
        if [[ "${OCI_RUNTIME}" == "crun" ]]; then
            DEVICE_ARGS+=(
                --group-add=keep-groups
            )
        else
            warn \
                "OCI runtime is ${OCI_RUNTIME}; /dev/kvm will be passed through without keep-groups"
        fi
    else
        warn "/dev/kvm exists but current user cannot access it; KVM disabled"
    fi
fi

#
# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
#

RUN_ARGS=(
    run
    --rm

    --interactive

    --userns=keep-id

    "${DEVICE_ARGS[@]}"

    #
    # Container gets no extra Linux capabilities.
    #
    --cap-drop=all
    --security-opt=no-new-privileges

    --hostname=codex-box
    --workdir="${CONTAINER_PWD}"

    --env="HOME=${CONTAINER_HOME}"
    --env="CODEX_HOME=${CONTAINER_HOME}/.codex"

    --env="XDG_CACHE_HOME=${CONTAINER_HOME}/.cache"

    --env="UV_CACHE_DIR=${CONTAINER_HOME}/.cache/uv"

    --env="MISE_DATA_DIR=${CONTAINER_HOME}/.local/share/mise"

    --env="TERM=${TERM:-xterm-256color}"

    "${MOUNTS[@]}"
)

#
# Only allocate a PTY when the caller actually has one.
#
# This keeps normal TUI use working while also allowing:
#
#   codex-box exec ...
#   codex-box shell -c ...
#   ... | codex-box ...
#
if [[ -t 0 && -t 1 ]]; then
    RUN_ARGS+=(--tty)
fi

#
# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
#

case "${1:-}" in
    shell)
        shift

        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            bash --login "$@"
        ;;

    doctor)
        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            bash -c '
                set -u

                printf "%-20s %s\n" "architecture:" "$(uname -m)"
                printf "%-20s %s\n" "user:" "$(id)"
                printf "%-20s %s\n" "workdir:" "$PWD"
                printf "%-20s %s\n" "codex:" "$(codex --version)"
                printf "%-20s %s\n" "python:" "$(python --version 2>&1)"
                printf "%-20s %s\n" "uv:" "$(uv --version)"
                printf "%-20s %s\n" "mise:" "$(mise --version)"
                printf "%-20s %s\n" "git:" "$(git --version)"
                printf "%-20s %s\n" "yq:" "$(yq --version)"
                printf "%-20s %s\n" "kubectl:" "$(kubectl version --client 2>/dev/null | head -1)"
                printf "%-20s %s\n" "helm:" "$(helm version --short)"
                printf "%-20s %s\n" "qemu-x86:" "$(qemu-system-x86_64 --version | head -1)"
                printf "%-20s %s\n" "qemu-arm64:" "$(qemu-system-aarch64 --version | head -1)"

                echo

                if [[ -r /dev/kvm && -w /dev/kvm ]]; then
                    echo "KVM device:          usable"

                    rc=0
                    timeout 2 \
                        qemu-system-x86_64 \
                        -accel kvm \
                        -machine none \
                        -nodefaults \
                        -display none \
                        >/dev/null 2>&1 || rc=$?

                    if [[ "${rc}" -eq 124 ]]; then
                        echo "amd64 KVM:           OK"
                    else
                        echo "amd64 KVM:           FAILED (rc=${rc})"
                    fi
                else
                    echo "KVM device:          unavailable"
                fi

                rc=0
                timeout 2 \
                    qemu-system-aarch64 \
                    -accel tcg \
                    -machine virt \
                    -cpu max \
                    -S \
                    -nodefaults \
                    -display none \
                    >/dev/null 2>&1 || rc=$?

                if [[ "${rc}" -eq 124 ]]; then
                    echo "arm64 TCG:           OK"
                else
                    echo "arm64 TCG:           FAILED (rc=${rc})"
                fi

                echo

                if [[ -d "$HOME/.agents/skills" ]]; then
                    broken=0

                    while IFS= read -r link; do
                        if [[ ! -e "${link}" ]]; then
                            echo "BROKEN agent skill: ${link} -> $(readlink "${link}")"
                            broken=1
                        fi
                    done < <(
                        find "$HOME/.agents/skills" -maxdepth 1 -type l
                    )

                    if [[ "${broken}" -eq 0 ]]; then
                        echo "agent skill links:   OK"
                    fi
                fi
            '
        ;;

    *)
        exec podman \
            "${RUN_ARGS[@]}" \
            "${IMAGE}" \
            codex \
            --dangerously-bypass-approvals-and-sandbox \
            "$@"
        ;;
esac
